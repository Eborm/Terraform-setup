{
  "id": null,
  "uid": "kubernetes-persistent-storage",
  "title": "Kubernetes Persistent Storage",
  "description": "PVC and PV inventory, binding status, and requested/provisioned capacity. Actual per-volume used space requires kubelet volume statistics to be scraped.",
  "tags": [
    "kubernetes",
    "storage",
    "pvc",
    "truenas"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Bound PVCs",
      "type": "stat",
      "description": "PersistentVolumeClaims currently Bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_persistentvolumeclaim_status_phase{phase=\"Bound\"} == 1) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Pending PVCs",
      "type": "stat",
